{
  "name": "google-ads-acquisition-planner",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check --minimumSeverity warning --minimumFailingSeverity warning",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run test && npm run typecheck && npm run lint && npm run format:check",
    "validate": "npm run check && npm run build",
    "prepare": "node scripts/setup-git-hooks.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.2",
    "astro": "^7.4.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "open-props": "^1.7.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
