---
import '../styles/global.css'
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Google Ads Acquisition Planner</title>
  </head>
  <body>
    <main>
      <h1>Google Ads Acquisition Planner</h1>
      <p>Simulateur et planificateur d'acquisition pour campagnes Google Ads.</p>
    </main>
  </body>
</html>

<style>
  main {
    display: grid;
    place-content: center;
    min-height: 100vh;
    padding: 1rem;
    text-align: center;
    gap: 0.5rem;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 800;
    color: #212529;
    margin: 0;
  }

  p {
    color: #6c757d;
    font-size: 1.25rem;
    margin: 0;
  }
</style>
