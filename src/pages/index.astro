---
import '../styles/global.css';
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Google Ads Calculator</title>
	</head>
	<body>
		<main>
			<h1>Google Ads Calculator</h1>
			<p>Simulateur et calculateur d'estimations pour campagnes Google Ads.</p>
		</main>
	</body>
</html>

<style>
	main {
		display: grid;
		place-content: center;
		min-height: 100vh;
		padding: var(--size-4, 1rem);
		text-align: center;
		gap: var(--size-2, 0.5rem);
	}

	h1 {
		font-size: var(--font-size-6, 2.5rem);
		font-weight: var(--font-weight-8, 800);
		color: var(--text-1, #212529);
		margin: 0;
	}

	p {
		color: var(--text-2, #6c757d);
		font-size: var(--font-size-3, 1.25rem);
		margin: 0;
	}
</style>
