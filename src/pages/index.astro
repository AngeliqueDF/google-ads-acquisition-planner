---
import "../styles/global.css";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Estimez le budget, le trafic et les prospects nécessaires pour évaluer la viabilité de Google Ads."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>Google Ads peut-il être rentable ? — Calculateur</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Accueil Google Ads Calculator">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>Ads / Calculator</span>
      </a>
      <span class="header-note">Outil gratuit · Sans inscription</span>
    </header>

    <main>
      <section class="hero" aria-labelledby="page-title">
        <p class="eyebrow">Google Ads viability calculator</p>
        <h1 id="page-title">
          Google Ads peut-il être rentable pour votre activité ?
        </h1>
        <p class="hero-copy">
          Estimez le budget, le trafic et le nombre de prospects nécessaires<br
            class="desktop-only"
          /> pour atteindre vos objectifs commerciaux.
        </p>
      </section>

      <nav class="step-nav" aria-label="Étapes du calculateur">
        <a href="#step-1" class="active" data-step-link="step-1"><span>01</span> Objectif</a>
        <a href="#step-2" data-step-link="step-2"><span>02</span> Vente</a>
        <a href="#step-3" data-step-link="step-3"><span>03</span> Acquisition</a>
      </nav>

      <div class="calculator-layout">
        <form
          class="calculator"
          aria-label="Hypothèses de votre scénario Google Ads"
        >
          <section class="step" id="step-1" aria-labelledby="step-1-title">
            <div class="step-heading">
              <span class="step-number">01</span>
              <div>
                <h2 id="step-1-title">Votre objectif</h2><p>
                  Commençons par ce qu’un nouveau client peut rapporter et le
                  résultat que vous cherchez à obtenir.
                </p>
              </div>
            </div>
            <div class="fields two-columns">
              <label class="field">
                <span>Valeur d’un nouveau client</span>
                <span class="input-shell"
                  ><input
                    type="number"
                    value="600"
                    min="0"
                    inputmode="decimal"
                  /><span class="unit">€</span></span
                >
                <small>Chiffre d’affaires moyen généré par un nouveau client.</small>
              </label>
              <label class="field">
                <span>Nouveaux clients visés</span>
                <span class="input-shell"
                  ><input
                    type="number"
                    value="10"
                    min="1"
                    inputmode="numeric"
                  /><span class="unit">clients</span></span
                >
                <small>Combien de nouveaux clients souhaitez-vous obtenir ?</small>
              </label>
              <label class="field field-wide">
                <span>Période</span>
                <select
                  ><option>Par mois</option><option>Par trimestre</option
                  ><option>Par an</option></select
                >
              </label>
            </div>
            <div class="inline-result">
              <span>Vous pouvez consacrer jusqu’à</span>
              <strong>180 €</strong>
              <span>pour acquérir un nouveau client</span>
              <small>CPA maximum</small>
            </div>
          </section>

          <section class="step" id="step-2" aria-labelledby="step-2-title">
            <div class="step-heading">
              <span class="step-number">02</span>
              <div>
                <h2 id="step-2-title">Votre processus commercial</h2><p>
                  Tous les prospects intéressés ne deviennent pas clients. Ces
                  chiffres permettent d’en tenir compte.
                </p>
              </div>
            </div>
            <div class="fields two-columns">
              <label class="field">
                <span>Taux de closing</span>
                <span class="input-shell"
                  ><input
                    type="number"
                    value="10"
                    min="0"
                    max="100"
                    inputmode="decimal"
                  /><span class="unit">%</span></span
                >
                <small>Sur 10 personnes intéressées, combien deviennent clientes ?</small>
              </label>
              <label class="field">
                <span>Marge moyenne</span>
                <span class="input-shell"
                  ><input
                    type="number"
                    value="30"
                    min="0"
                    max="100"
                    inputmode="decimal"
                  /><span class="unit">%</span></span
                >
                <small>Part du chiffre d’affaires qui reste après les coûts directement liés à la vente ou à la prestation.</small>
              </label>
            </div>
            <div class="inline-result">
              <span>Un nouveau contact peut vous coûter jusqu’à</span>
              <strong>18 €</strong>
              <span>pour rester dans votre objectif</span>
              <small>Coût maximum par prospect</small>
            </div>
          </section>

          <section class="step" id="step-3" aria-labelledby="step-3-title">
            <div class="step-heading">
              <span class="step-number">03</span>
              <div>
                <h2 id="step-3-title">Votre acquisition</h2><p>
                  Ajoutons maintenant les hypothèses liées à votre campagne et
                  à votre page.
                </p>
              </div>
            </div>
            <div class="fields two-columns">
              <label class="field">
                <span>Taux de conversion</span>
                <span class="input-shell"
                  ><input
                    type="number"
                    value="5"
                    min="0"
                    max="100"
                    inputmode="decimal"
                  /><span class="unit">%</span></span
                >
                <small>Sur 100 visiteurs, combien deviennent prospects ?</small>
              </label>
              <label class="field">
                <span>CPC estimé</span>
                <span class="input-shell"
                  ><input
                    type="number"
                    value="2.50"
                    min="0"
                    step="0.1"
                    inputmode="decimal"
                  /><span class="unit">€</span></span
                >
                <small>Combien pensez-vous payer pour un clic sur votre annonce ?</small>
              </label>
            </div>
            <button class="helper-link" type="button"
              ><span aria-hidden="true">?</span> Je ne connais pas ce chiffre</button
            >
          </section>

          <section
            class="mobile-result result-box"
            aria-label="Résumé du scénario"
          >
            <p class="result-kicker">Votre scénario</p>
            <h2 class="result-title">Avec ces hypothèses, Google Ads ne serait pas encore rentable.</h2>
            <div class="result-comparison">
              <div><strong>50 €</strong><span>coût estimé par prospect</span></div>
              <span class="comparison-word">contre</span>
              <div><strong>18 €</strong><span>maximum recommandé par prospect</span></div>
            </div>
            <div class="result-metrics">
              <p><strong>100</strong><span>prospects nécessaires</span></p>
              <p><strong>2 000</strong><span>clics estimés</span></p>
              <p><strong>5 000 €</strong><span>budget publicitaire estimé</span></p>
            </div>
          </section>
        </form>

        <aside class="result-panel" aria-label="Résumé du scénario">
          <div class="result-box">
            <p class="result-kicker">Votre scénario</p>
            <h2 class="result-title">Avec ces hypothèses, Google Ads ne serait pas encore rentable.</h2>
            <div class="result-comparison">
              <div><strong>50 €</strong><span>coût estimé par prospect</span></div>
              <span class="comparison-word">contre</span>
              <div><strong>18 €</strong><span>maximum recommandé par prospect</span></div>
            </div>
            <div class="result-metrics">
              <p><strong>100</strong><span>prospects nécessaires</span></p>
              <p><strong>2 000</strong><span>clics estimés</span></p>
              <p><strong>5 000 €</strong><span>budget publicitaire estimé</span></p>
            </div>
            <p class="result-footnote">
              Ajustez vos hypothèses pour rapprocher le coût estimé du maximum
              recommandé.
            </p>
          </div>
        </aside>
      </div>

      <section class="method" aria-labelledby="method-title">
        <div>
          <p class="eyebrow">La logique derrière le résultat</p><h2
            id="method-title"
          >
            Un modèle simple,<br />pour décider plus clairement.
          </h2>
        </div>
        <div class="method-copy">
          <p>
            Le calcul part de la valeur d’un nouveau client et remonte jusqu’au
            coût que vous pouvez accepter pour générer un clic.
          </p>
          <ol>
            <li>
              <span>01</span><p>
                <strong>Objectif commercial</strong>Valeur d’un client et
                nombre de nouveaux clients souhaités.
              </p>
            </li>
            <li>
              <span>02</span><p>
                <strong>Réalité de la vente</strong>Tous les prospects ne
                deviennent pas clients, et chaque vente a un coût.
              </p>
            </li>
            <li>
              <span>03</span><p>
                <strong>Hypothèses média</strong>Le taux de conversion de votre
                page et le coût par clic permettent d’estimer le trafic et le
                budget nécessaires.
              </p>
            </li>
          </ol>
        </div>
      </section>

      <section class="faq" aria-labelledby="faq-title">
        <p class="eyebrow">Questions fréquentes</p>
        <h2 id="faq-title">Avant de lancer vos campagnes</h2>
        <div class="faq-list">
          <details>
            <summary>Où trouver une estimation du CPC&nbsp;?</summary><p>
              Utilisez le planificateur de mots-clés Google Ads ou partez d’une
              hypothèse prudente, puis testez plusieurs scénarios.
            </p>
          </details>
          <details>
            <summary>Que signifie « scénario limite »&nbsp;?</summary><p>
              Votre coût estimé est proche du maximum acceptable. Une campagne
              peut fonctionner, mais elle laisse peu de marge aux imprévus.
            </p>
          </details>
          <details>
            <summary
              >Ces résultats garantissent-ils la rentabilité&nbsp;?</summary
            ><p>
              Non. Ils servent à cadrer une décision. Les résultats réels
              dépendront notamment de votre marché, de vos annonces et de votre
              page d’atterrissage.
            </p>
          </details>
        </div>
      </section>
    </main>

    <footer>
      <a class="brand" href="/">Ads / Calculator</a><p>
        Un point de départ pour prendre de meilleures décisions média.
      </p>
    </footer>
    <script>
      const stepLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-step-link]')];
      const stepSections = [...document.querySelectorAll<HTMLElement>('.step[id]')];

      const stepObserver = new IntersectionObserver((entries) => {
        const visibleStep = entries.find((entry) => entry.isIntersecting);
        if (!visibleStep) return;

        stepLinks.forEach((link) => {
          const isCurrent = link.dataset.stepLink === visibleStep.target.id;
          link.classList.toggle('active', isCurrent);
          if (isCurrent) link.setAttribute('aria-current', 'step');
          else link.removeAttribute('aria-current');
        });
      }, { rootMargin: '-30% 0px -60% 0px' });

      stepSections.forEach((section) => stepObserver.observe(section));
    </script>
  </body>
</html>
